--- !u!114 &2068497387
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2068497381}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96f4b8bb26f03a54ea4c6717cb38045f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcID: 2
  npcName: Maarith
  defaultConversation:
  - speaker: 1
    text: 'Oh, bienvenue ! Quel bonheur de vous voir ici. Ce sera un immense plaisir
      pour moi de vous accompagner et de vous ouvrir les portes de notre humble foyer. '
  - speaker: 1
    text: "Je vais vous pr\xE9senter mes fr\xE8res et s\u0153urs ; c'est une famille
      un peu... particuli\xE8re, mais vous verrez, ils ont tous un c\u0153ur d'or
      !"
  - speaker: 1
    text: "Enfin, presque tous. Je ne suis pas certain que vous puissiez discuter
      avec tout le monde. Certains sont... tr\xE8s difficiles \xE0 trouver."
  - speaker: 1
    text: "Comme  Sylv. Ne perdez pas votre temps \xE0 le chercher. Sa pr\xE9sence
      n'apporte rien \xE0 la visite, et son absence encore moins. Continuons, si
      vous le voulez bien."
  specializedDialogues: []
  playOnlyOnce: 1
  rotationSpeed: 5
